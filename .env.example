# --- PostgreSQL ---
POSTGRES_USER=gastroai
POSTGRES_PASSWORD=gastroai
POSTGRES_DB=gastroai
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis / Celery ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- MinIO (S3-compatible object storage) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=gastroai
MINIO_SECURE=false

# --- App / Auth ---
SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Seed data (superadmin) ---
SUPERADMIN_EMAIL=admin@gastroai.com
SUPERADMIN_PASSWORD=admin12345

# --- External AI services (leave empty for stub mode) ---
HUGGINGFACE_API_URL=
HUGGINGFACE_TOKEN=
LLM_API_URL=
LLM_API_KEY=
