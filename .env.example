# Opcional. La configuración de la aplicación vive en backend/.env (copia de
# backend/.env.example). Este archivo solo hace falta si cambias las credenciales de
# Postgres o MinIO: docker-compose.yml de la raíz las lee de aquí, y TIENEN que ser las
# mismas que pusiste en backend/.env. Sin este archivo se usan estos mismos valores.

POSTGRES_USER=gastroia
POSTGRES_PASSWORD=gastroia_dev
POSTGRES_DB=gastroia

S3_ACCESS_KEY=gastroia
S3_SECRET_KEY=gastroia_dev_secret
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000

# --- Solo producción (docker-compose.prod.yml) ---------------------------------
# Ahí estas variables son OBLIGATORIAS (no hay valores de desarrollo por defecto):
# POSTGRES_PASSWORD, S3_SECRET_KEY, S3_PUBLIC_ENDPOINT_URL y SMTP_HOST.
# S3_PUBLIC_ENDPOINT_URL=https://gastroai.ejemplo.edu.co:9000
# Carpeta con fullchain.pem y privkey.pem (por defecto backend/docker/nginx/certs)
# NGINX_CERTIFICADOS=./backend/docker/nginx/certs
# SMTP real (el resto, usuario y clave, va en backend/.env)
# SMTP_HOST=smtp.ejemplo.edu.co
# SMTP_PORT=587
