# Opcional. La configuración de la aplicación vive en backend/.env (copia de
# backend/.env.example). Este archivo solo hace falta si cambias las credenciales de
# Postgres o MinIO: docker-compose.yml de la raíz las lee de aquí, y TIENEN que ser las
# mismas que pusiste en backend/.env. Sin este archivo se usan estos mismos valores.

POSTGRES_USER=gastroia
POSTGRES_PASSWORD=gastroia_dev
POSTGRES_DB=gastroia

S3_ACCESS_KEY=gastroia
S3_SECRET_KEY=gastroia_dev_secret
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
