# Copia este archivo como .env y ajusta los valores. Solo valores de desarrollo:
# los marcados «cambia-esto» deben generarse para cada entorno y nunca subirse al repositorio.
# development | production. Con production el backend no arranca si falta una clave o
# queda un valor de desarrollo, y nunca usa el Space simulado.
ENVIRONMENT=development

POSTGRES_USER=gastroia
POSTGRES_PASSWORD=gastroia_dev
POSTGRES_DB=gastroia
DATABASE_URL=postgresql+psycopg://gastroia:gastroia_dev@localhost:5432/gastroia

REDIS_URL=redis://localhost:6379/0
EVENTOS_INTERVALO_SEGUNDOS=15

S3_ENDPOINT_URL=http://localhost:9000
# Host que va en las URL firmadas (lo que abre el navegador). Vacío = igual a S3_ENDPOINT_URL
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_URL_FIRMADA_SEGUNDOS=300
# Minutos que dura la imagen cargada antes de solicitar el análisis (POST /imagenes)
IMAGEN_TEMPORAL_MINUTOS=30
S3_ACCESS_KEY=gastroia
S3_SECRET_KEY=gastroia_dev_secret
S3_BUCKET=gastroia-imagenes

# Seudónimo HMAC (RNF-28). JSON con todas las versiones; HMAC_VERSION_ACTUAL es la que firma casos nuevos.
# Generar una clave: python -c "import secrets; print(secrets.token_hex(32))"
HMAC_CLAVES={"1":"cambia-esto-por-una-clave-de-64-caracteres-hex"}
HMAC_VERSION_ACTUAL=1

# Cifrado del secreto TOTP (AES-256-GCM, 32 bytes en Base64)
# Generar: python -c "import base64, secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())"
TOTP_CLAVE_CIFRADO=cambia-esto-por-32-bytes-en-base64

# Space privado de Hugging Face, modelo Fold 2 (RM-08). URL, repo, revisión y huella son
# datos públicos de identificación; HF_TOKEN y GASTROAI_API_KEY son secretos: los entrega
# el equipo de ML por un canal privado y nunca se suben al repositorio.
HF_SPACE_URL=https://cris158127-gastroai-inferencia-fold2.hf.space
HF_TOKEN=
# Clave compartida con el Space (cabecera X-API-Key): la misma configurada en Hugging Face
GASTROAI_API_KEY=
HF_REPO=spaces/cris158127/gastroai-inferencia-fold2
HF_REVISION=d58d56d7fd24a3760779e15d98413d276cb77ad0
HF_SHA256=9e680720f6feb7f81aa66fdc89a28471bb3e1a6e8772598d5b0890cc817f42c4
HTTP_TIMEOUT_SECONDS=30
# true = resultados simulados sin llamar al Space (solo con ENVIRONMENT=development)
HF_SIMULADO=false
# Ruta de los pesos dentro de HF_REPO, pa que el respaldo guarde una copia (RNF-26).
# Si HF_REPO es un Space, va con «spaces/» adelante: spaces/ragnartech/gastro-ai
HF_PESOS_ARCHIVO=best_gastroai_efficientnet_b1_3cat_fold2_v8.pth

LLM_PROVEEDOR=gemini
LLM_MODELO=gemini-3.5-flash
# Razonamiento del modelo: LOW (recomendado, ~2 s), MEDIUM, HIGH o vacío
LLM_RAZONAMIENTO=LOW
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=15

# Primer administrador (carga inicial). Entra con la temporal y debe cambiarla (vence a las 72 h).
ADMIN_CORREO=admin@gastroia.local
ADMIN_TEMPORAL=cambia-esto-temporal

# Correo saliente (SMTP con TLS)
SMTP_HOST=smtp.ejemplo.com
SMTP_PORT=587
SMTP_USUARIO=
SMTP_CONTRASENA=
SMTP_REMITENTE=Gastro-AI <no-responder@gastroia.local>
SMTP_STARTTLS=true
SMTP_TIMEOUT_SECONDS=10

# Panel de supervisión (RF-A04): tiempo máximo por servicio y URL de la aplicación web
MONITOREO_TIMEOUT_SECONDS=3
MONITOREO_APP_WEB_URL=http://nginx/

# Sesión y bloqueo (RF-U10, RF-U12, RNF-03): valores de los requisitos, no los aflojes
SESION_INACTIVIDAD_MINUTOS=10
BLOQUEO_INTENTOS=5
BLOQUEO_MINUTOS=15

# Contraseñas filtradas (RF-U02) con Have I Been Pwned por k-anonimato
CONTRASENAS_FILTRADAS_ACTIVO=true
CONTRASENAS_FILTRADAS_URL=https://api.pwnedpasswords.com/range/
CONTRASENAS_FILTRADAS_TIMEOUT_SECONDS=3
